# NeuroFlow Environment Variables

# Application
NEXT_PUBLIC_APP_NAME=NeuroFlow
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_EXPORT=true
NEXT_PUBLIC_ENABLE_CLOUD_SYNC=false
NEXT_PUBLIC_ENABLE_DEBUG_MODE=false

# Audio Settings
NEXT_PUBLIC_DEFAULT_VOLUME=0.5
NEXT_PUBLIC_BINAURAL_BASE_FREQ=200
NEXT_PUBLIC_MAX_VOLUME=1.0

# EEG Processing
NEXT_PUBLIC_SAMPLE_RATE=256
NEXT_PUBLIC_BUFFER_SIZE=512
NEXT_PUBLIC_MAX_LATENCY_MS=50

# Flow Detection
NEXT_PUBLIC_CALIBRATION_MIN_SAMPLES=60
NEXT_PUBLIC_FLOW_TARGET_SUCCESS_RATE=0.70
NEXT_PUBLIC_COGNITIVE_LOAD_MIN=0.4
NEXT_PUBLIC_COGNITIVE_LOAD_MAX=0.6

# Visualization
NEXT_PUBLIC_DEFAULT_PARTICLE_COUNT=10000
NEXT_PUBLIC_MAX_PARTICLE_COUNT=20000
NEXT_PUBLIC_TARGET_FPS=60

# Storage
NEXT_PUBLIC_DB_NAME=neuroflow
NEXT_PUBLIC_DB_VERSION=1
NEXT_PUBLIC_MAX_SESSION_HISTORY=1000

# Development
NEXT_PUBLIC_MOCK_EEG_DATA=false
NEXT_PUBLIC_MOCK_BLUETOOTH=false
NEXT_PUBLIC_SHOW_PERFORMANCE_STATS=false

# Analytics (Optional - for production)
# NEXT_PUBLIC_GA_TRACKING_ID=
# NEXT_PUBLIC_SENTRY_DSN=

# API Keys (if using external services)
# NEXT_PUBLIC_MUSE_API_KEY=
