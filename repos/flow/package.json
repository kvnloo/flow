{
  "name": "neuroflow",
  "version": "1.0.0",
  "description": "EEG neurofeedback training application for flow state optimization",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --dir src",
    "test:integration": "vitest run --dir src/__tests__/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:perf": "vitest run --dir src/__tests__/performance",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "prepare": "husky install",
    "pre-commit": "lint-staged"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@react-three/fiber": "^8.16.0",
    "@react-three/drei": "^9.105.0",
    "three": "^0.163.0",
    "rxjs": "^7.8.1",
    "tone": "^15.0.4",
    "zustand": "^4.5.2",
    "recharts": "^2.12.0",
    "next-themes": "^0.3.0",
    "geist": "^1.3.0",
    "lucide-react": "^0.index363.0",
    "simplex-noise": "^4.0.1",
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.163.0",
    "typescript": "^5.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "vitest": "^1.5.0",
    "@vitest/ui": "^1.5.0",
    "@vitest/coverage-v8": "^1.5.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@testing-library/react": "^15.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/user-event": "^14.5.0",
    "jsdom": "^24.0.0",
    "@playwright/test": "^1.43.0",
    "playwright": "^1.43.0",
    "prettier": "^3.2.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "raw-loader": "^4.0.2",
    "glslify-loader": "^2.0.0"
  },
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "neurofeedback",
    "eeg",
    "flow-state",
    "muse",
    "brainwaves",
    "meditation",
    "focus",
    "concentration",
    "binaural-beats",
    "three.js",
    "react",
    "nextjs"
  ],
  "author": "NeuroFlow Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/neuroflow.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/neuroflow/issues"
  },
  "homepage": "https://neuroflow.vercel.app"
}
